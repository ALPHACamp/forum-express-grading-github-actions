<div>
<div class="container bg-white">
  <div class="row">
    <div class="col-4 ps-0">
      <img src="{{#if user.image}}{{user.image}}{{else}}/upload/default-profile-picture.jpg{{/if}}"
        class="img-thumbnail img-responsive">
    </div>
    <div class="col-8">
      <h1>{{user.name}}</h1>
      <h2>{{user.email}}</h2>
      <h2>已評論餐廳: {{user.totalComments}}</h2>
      <a href="/users/{{user.id}}/edit" class="btn btn-primary">Edit</a>
    </div>
  </div>
</div>
<div class="mt-5 bg-white">
  <div class="bg-secondary">
    <h2>已評論餐廳:{{user.totalComments}}</h2>
  </div>
  <div class="p-3 row justify-content-md-center">
    {{#each user.Comments}}
      <div class="m-1 col-2">
        <a href="/restaurants/{{this.Restaurant.id}}">
          <img src="{{this.Restaurant.image}}" class="img-responsive" style="width: 100%">
        </a>
      </div>
    {{/each}}
    </div>
  </div>
</div>
</div>


